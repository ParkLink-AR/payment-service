PORT=8004
DATABASE_URL=postgresql://user_payment:pass_payment@localhost:5436/payment_db

# Debe coincidir con GATEWAY_INTERNAL_SECRET del gateway: valida que las
# requests a create-preference/verify-status/paymentId/external-reference
# vengan realmente a través de él. En producción es obligatorio (>=32
# caracteres, sin valores por defecto) o el servicio no arranca.
GATEWAY_INTERNAL_SECRET=

# Credenciales de Mercado Pago (obtenelas en https://www.mercadopago.com.ar/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_LA_SECRET_DE_MERCADO_PAGO

# Email del comprador de prueba de MP. En desarrollo podés usar el del sandbox;
# en producción dejarlo vacío para que use el email real del usuario.
MP_FORCE_TEST_PAYER_EMAIL=

# URL interna del servicio (sin barra final)
APP_BASE_URL=http://localhost:8004

# WEBHOOK_BASE_URL: URL *pública* que Mercado Pago puede alcanzar para notificarte.
# En desarrollo, usá un túnel ngrok:
#   npx ngrok http 8004   →  copia la URL https://xxxx.ngrok.io aquí
# En producción, la URL pública del servidor.
WEBHOOK_BASE_URL=https://xxxx.ngrok.io

# Solo dev: saltea la verificación HMAC de la firma del webhook de MP. Útil
# cuando tunelizás el webhook y la secret/firma no coinciden. NUNCA en prod.
MP_SKIP_WEBHOOK_SIGNATURE=false

# Deep links de la app móvil. MP redirige al usuario aquí al terminar el pago.
# Deben coincidir con el scheme registrado en app.json (parklink://).
# auto_return solo aplica si FRONTEND_SUCCESS_URL es https://; con deep links
# el redirect lo maneja la app al volver del WebBrowser.
FRONTEND_SUCCESS_URL=parklink://payment/success
FRONTEND_FAILURE_URL=parklink://payment/failure
FRONTEND_PENDING_URL=parklink://payment/pending

DEFAULT_CURRENCY=ARS

# Booking service – usado para confirmar la reserva tras un pago aprobado
BOOKING_SERVICE_URL=http://localhost:8080
BOOKING_SERVICE_AUTH_TOKEN=

# admin-dashboard le pega directo a este servicio (no vía gateway) para
# /api/payments/metrics, así que necesita su propio CORS. "*" sirve para
# dev local; en producción restringilo al origen real del admin-dashboard,
# ej. https://parklink-admin-dashboard.onrender.com
CORS_ORIGINS=*
